# Sat+ / QaiArzan — пример переменных окружения.
# Скопируйте в .env.local (локально) или задайте в Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Только сервер. НИКОГДА не добавляйте префикс NEXT_PUBLIC_ и не коммитьте реальное значение.
# Нужен для загрузки фото заявок в приватное хранилище, журнала аудита и удаления аккаунта.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Соль для хэша IP+User-Agent (антиспам и лимиты). Сами IP не хранятся.
# Обязательна в production. Сгенерировать: openssl rand -hex 32
CLIENT_HASH_SALT=change-me-to-a-long-random-string

# Публичный адрес сайта: canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://satplus.kz

# Разделы Sat+ (необязательно). По умолчанию включены QaiArzan (prices), Новости (news), Акции (promotions), Организации (businesses), Услуги (services) и Работа (jobs).
# Выключенный раздел показывает страницу «В разработке», а не 404.
# NEXT_PUBLIC_FEATURE_PRICES=true
# NEXT_PUBLIC_FEATURE_NEWS=true
# NEXT_PUBLIC_FEATURE_PROMOTIONS=true
# NEXT_PUBLIC_FEATURE_BUSINESSES=true
# NEXT_PUBLIC_FEATURE_SERVICES=true
# NEXT_PUBLIC_FEATURE_JOBS=true
# NEXT_PUBLIC_FEATURE_CLASSIFIEDS=false
# NEXT_PUBLIC_FEATURE_EVENTS=false
# NEXT_PUBLIC_FEATURE_TRANSPORT=false
# NEXT_PUBLIC_FEATURE_CITY_REPORTS=false
# NEXT_PUBLIC_FEATURE_REVIEWS=false
